@startuml
skinparam ConditionStyle InsideDiamond
skinparam shadowing false
skinparam defaultFontName "Noto Sans"
skinparam activity {
  BackgroundColor #FFFDF8
  BorderColor #5D4037
  DiamondBackgroundColor #F5E9DA
  DiamondBorderColor #5D4037
  ArrowColor #5D4037
}

|Khách hàng|
start
:Mở giỏ hàng;

|Next.js UI|
:Kiểm tra giỏ có thể đặt\n(POST /api/products/availability);
if (Giỏ đã kiểm tra và đủ điều kiện?) then (Có)
else (Không)
  :Khóa nút đặt hàng và báo trạng thái kiểm tra hoặc thiếu kho;
  stop
endif

if (Đã đăng nhập?) then (Có)
else (Không)
  :Hiện nút Đăng nhập;
  |Khách hàng|
  :Đăng nhập;
  |Next.js UI|
  :Quay lại checkout;
endif
|Next.js UI|
:Hiển thị tóm tắt đơn;

|Khách hàng|
:Chọn Ví hoặc Thẻ và xác nhận đặt hàng;
|Next.js UI|
:Gửi POST /api/orders;

|NestJS API|
:Xác thực JWT và kiểm tra DTO;
if (Yêu cầu hợp lệ?) then (Có)
else (Không)
  :Trả 401 hoặc 400;
  |Next.js UI|
  :Hiển thị lỗi tạo đơn;
  stop
endif

|PostgreSQL|
:Bắt đầu transaction tạo đơn;
|NestJS API|
:Tính lại giá và lượng nguyên liệu,\nkiểm tra voucher nếu có;
if (Dữ liệu món và voucher hợp lệ?) then (Có)
else (Không)
  |PostgreSQL|
  :Rollback transaction tạo đơn;
  |Next.js UI|
  :Hiển thị lỗi dữ liệu hoặc voucher;
  stop
endif

|PostgreSQL|
:Khóa và kiểm tra tồn nguyên liệu;
if (Đủ nguyên liệu?) then (Có)
  :Trừ tồn, lưu Order PENDING, snapshot món\nvà Reservation ACTIVE kèm định lượng giữ kho;
  :Commit transaction tạo đơn;
  |NestJS API|
  :Trả 201 kèm orderId;
else (Không)
  |PostgreSQL|
  :Rollback transaction tạo đơn;
  |NestJS API|
  :Trả 409 thiếu kho;
  |Next.js UI|
  :Hiển thị lỗi thiếu nguyên liệu;
  stop
endif

|Next.js UI|
repeat :Chuẩn bị lần gửi thanh toán trên cùng orderId;
  note right
    Lần đầu hoặc sau FAILED: tạo khóa mới.
    Gửi lại khi chưa rõ kết quả: dùng lại khóa.
    Cùng khóa phải giữ nguyên orderId và phương thức.
  end note
  :POST /api/payments\nBody: orderId, method\nHeader: Idempotency-Key;

  |NestJS API|
  :Xác thực JWT, kiểm tra yêu cầu và tra cứu theo khóa;
  if (Đã có Payment với khóa này?) then (Có · Gửi lại)
    |NestJS API|
    :Đối chiếu chủ đơn, orderId và phương thức;
    if (Đúng chủ đơn và cùng nội dung?) then (Có)
      :Trả trạng thái đã lưu\n(có thể vẫn PROCESSING);
    else (Không)
      :Trả 403 sai chủ đơn hoặc 409 xung đột khóa;
      |Next.js UI|
      :Hiển thị lỗi thanh toán;
      stop
    endif
  else (Chưa · Lần mới)
    |PostgreSQL|
    :Bắt đầu transaction khởi tạo thanh toán;
    |NestJS API|
    :Kiểm tra chủ đơn và điều kiện mở lần thanh toán;
    if (Có thể mở lần thanh toán mới?) then (Có)
    else (Không)
      |PostgreSQL|
      :Rollback transaction khởi tạo;
      |NestJS API|
      :Trả lỗi tương ứng;
      |Next.js UI|
      :Hiển thị lỗi thanh toán;
      stop
    endif

    |PostgreSQL|
    if (Đơn đang PAYMENT_FAILED?) then (Có)
      :Khóa và kiểm tra tồn theo định lượng đã lưu;
      if (Còn đủ nguyên liệu?) then (Có)
        :Trừ tồn lại, chuyển Reservation sang ACTIVE\nvà Order về PENDING;
      else (Không)
        :Rollback transaction khởi tạo;
        |NestJS API|
        :Trả 409 thiếu kho;
        |Next.js UI|
        :Hiển thị lỗi thiếu nguyên liệu;
        stop
      endif
    endif
    |PostgreSQL|
    :Lưu Payment PROCESSING và commit;
    |Payment Service|
    :Sandbox;

    |PostgreSQL|
    :Bắt đầu transaction ghi kết quả thanh toán;
    if (Kết quả PAID?) then (PAID)
      :Lưu Payment và Order PAID, Reservation CONSUMED.\nGhi điểm và lượt dùng voucher nếu áp dụng;
    else (Không)
      if (Kết quả FAILED?) then (FAILED)
        :Lưu Payment FAILED, Order PAYMENT_FAILED.\nHoàn kho đúng một lần và lưu Reservation RELEASED;
      else (Không)
        if (Kết quả PROCESSING?) then (PROCESSING)
          :Giữ Payment PROCESSING, Order PENDING\nvà Reservation ACTIVE;
        else (TIMEOUT / UNKNOWN)
          :Lưu Payment UNKNOWN, giữ Order PENDING\nvà Reservation ACTIVE;
        endif
      endif
    endif
    |PostgreSQL|
    :Commit transaction ghi kết quả;
    note right
      Nếu ghi kết quả thất bại: rollback transaction này.
      API trả 500; Payment đã lưu trước đó vẫn PROCESSING.
    end note
    |NestJS API|
    :Trả kết quả thanh toán;
  endif

  |Next.js UI|
  if (Payment PAID?) then (Có)
    :Xóa giỏ và hiển thị mã đơn;
    stop
  endif

  if (Payment FAILED?) then (FAILED)
    :Thông báo bị từ chối và cho thử lại;
  else (PROCESSING / UNKNOWN)
    :Báo đang xử lý hoặc chưa xác định kết quả;
  endif

  |Khách hàng|
repeat while (Chủ động gửi lại thanh toán?) is (Có) not (Không)

stop
@enduml
