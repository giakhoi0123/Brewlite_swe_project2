@startuml

title Activity Diagram - Checkout VNPay

skinparam shadowing false
skinparam defaultFontName "Noto Sans"
skinparam activity {
  BackgroundColor #FFFDF8
  BorderColor #5D4037
  DiamondBackgroundColor #F5E9DA
  DiamondBorderColor #5D4037
  ArrowColor #5D4037
}

|Khách hàng|
start
:Mở giỏ hàng và chọn thanh toán;

|Next.js UI|
if (JWT hợp lệ?) then (Không)
  :Chuyển đến đăng nhập;
  |Khách hàng|
  :Đăng nhập;
  |Next.js UI|
endif
:Gửi POST /api/orders\n(items, voucherCode, pointsToRedeem, notes);

|NestJS API|
:Xác thực JWT, validate DTO;
:Đọc sản phẩm/option và tính lại giá;
:Kiểm tra voucher;

|PostgreSQL|
:BEGIN transaction tạo đơn;
if (pointsToRedeem hợp lệ?) then (Không)
  :ROLLBACK;
  |NestJS API|
  :Trả 400 Bad Request;
  |Next.js UI|
  :Thông báo điểm không hợp lệ/không đủ;
  stop
else (Có / không sử dụng điểm)
  :Atomic decrement loyaltyPoints;\nghi LoyaltyLog âm nếu đổi điểm;
endif
:Khóa Ingredient theo thứ tự ID;
if (Đủ tồn kho?) then (Không)
  :ROLLBACK;
  |NestJS API|
  :Trả 409 Conflict;
  |Next.js UI|
  :Thông báo thiếu nguyên liệu;
  stop
else (Có)
  :Trừ tồn kho;
  :Tạo Order PENDING + OrderItem snapshot\n+ reservation ACTIVE + reservation lines;
  :COMMIT;
endif

|Next.js UI|
:Nhận 201 Created + orderId;

repeat
  :Sinh Idempotency-Key mới;
  :Gửi POST /api/payments\n(orderId, method=VNPAY);

  |NestJS API|
  :Kiểm tra chủ đơn và Idempotency-Key;
  if (Key đã tồn tại?) then (Có)
    :Trả lại đúng kết quả đã lưu;
  else (Không)
    |PostgreSQL|
    :BEGIN Transaction A;
    if (Order = PAYMENT_FAILED?) then (Có)
      :Khóa và kiểm tra lại Ingredient;
      if (Còn đủ tồn kho?) then (Không)
        :ROLLBACK;
        |NestJS API|
        :Trả 409 ORDER_NOT_PAYABLE;
        |Next.js UI|
        :Thông báo không thể thanh toán lại;
        stop
      else (Có)
        :Trừ kho; Reservation RELEASED -> ACTIVE;
        :Order PAYMENT_FAILED -> PENDING;\nghi OrderStatusHistory;
      endif
    else (Order = PENDING)
      :Xác nhận reservation ACTIVE;
    endif
    :Tạo Payment PROCESSING;
    :COMMIT Transaction A;

    |NestJS API|
    :Tạo URL VNPay ký HMAC-SHA512;
    |PostgreSQL|
    :Lưu providerTxnRef, checkoutUrl, expiresAt;
    |NestJS API|
    :Trả HTTP 202 PROCESSING + checkoutUrl;

    |Next.js UI|
    :Redirect trình duyệt sang VNPay Sandbox;
    |VNPay Sandbox|
    :Khách xác thực giao dịch;
    :Gửi GET /api/payments/vnpay-ipn;

    |NestJS API|
    :Xác thực checksum, TmnCode, TxnRef và amount;
    if (Kết quả IPN?) then (Thành công 00/00)
      |PostgreSQL|
      :BEGIN Transaction B;
      :Reservation ACTIVE -> CONSUMED;
      :Order -> PAID; ghi OrderStatusHistory;
      :Cộng floor(total / 10.000) loyaltyPoints;\nghi LoyaltyLog nếu chưa cộng;
      :Tăng Promotion.usedCount nếu đơn có promotion;
      :Payment -> PAID; lưu transaction no/date;
      :COMMIT Transaction B;
    elseif (Thất bại xác định) then (FAILED)
      |PostgreSQL|
      :BEGIN Transaction B;
      :Hoàn nguyên liệu đúng một lần;
      :Reservation ACTIVE -> RELEASED;
      :Order -> PAYMENT_FAILED; Payment -> FAILED;
      :COMMIT Transaction B;
    else (Chưa xác định)
      |PostgreSQL|
      :Payment -> UNKNOWN; Order vẫn PENDING;
    endif

    |NestJS API|
    :Trả RspCode cho VNPay;
    |VNPay Sandbox|
    :Redirect GET /api/payments/vnpay-return;
    |NestJS API|
    :Kiểm tra chữ ký Return và redirect 302 về web;
    |Next.js UI|
    :Polling GET /api/payments/:paymentId;
  endif

  if (Payment = PAID?) then (Có)
    :Xóa giỏ hàng và hiển thị thành công;
    stop
  elseif (Payment = FAILED?) then (Có)
    :Hiển thị thất bại và cho phép thử lại;
    |Khách hàng|
    :Chọn thử thanh toán lại hoặc dừng;
    |Next.js UI|
  else (PROCESSING / UNKNOWN)
    :Giữ màn hình chờ để đối soát;
    stop
  endif
repeat while (Khách chọn thử lại?) is (Có)

:Hiển thị giao dịch thất bại;
stop

@enduml
