@startuml
skinparam ConditionStyle InsideDiamond
skinparam shadowing false
skinparam defaultFontName "Noto Sans"
skinparam activity {
  BackgroundColor #FFFDF8
  BorderColor #5D4037
  DiamondBackgroundColor #F5E9DA
  DiamondBorderColor #5D4037
  ArrowColor #5D4037
}

|Khách hàng|
start
:Mở giỏ hàng;

|Next.js UI|
:Kiểm tra giỏ có thể đặt\n(POST /api/products/availability);
if (Giỏ đã kiểm tra và đủ điều kiện?) then (Có)
else (Không)
  :Khóa nút đặt hàng và báo trạng thái kiểm tra hoặc thiếu kho;
  stop
endif

if (Đã đăng nhập?) then (Có)
else (Không)
  :Hiện nút Đăng nhập;
  |Khách hàng|
  :Đăng nhập;
  |Next.js UI|
  :Quay lại checkout;
endif
|Next.js UI|
:Hiển thị tóm tắt đơn;

|Khách hàng|
:Xác nhận thanh toán VNPay Sandbox;
|Next.js UI|
:Gửi POST /api/orders;

|NestJS API|
:Xác thực JWT và kiểm tra DTO;
if (Yêu cầu hợp lệ?) then (Có)
else (Không)
  :Trả 401 hoặc 400;
  |Next.js UI|
  :Hiển thị lỗi tạo đơn;
  stop
endif

|PostgreSQL|
:Bắt đầu transaction tạo đơn;
|NestJS API|
:Tính lại giá, định lượng nguyên liệu,\nkiểm tra voucher và pointsToRedeem;
if (Dữ liệu món, voucher và điểm hợp lệ?) then (Có)
else (Không)
  |PostgreSQL|
  :Rollback transaction tạo đơn;
  |Next.js UI|
  :Hiển thị lỗi dữ liệu, voucher hoặc điểm;
  stop
endif

|PostgreSQL|
if (pointsToRedeem > 0?) then (Có)
  :Trừ User.loyaltyPoints và ghi\nLoyaltyTransaction (type=REDEEM);
endif
:Khóa SELECT FOR UPDATE và kiểm tra tồn nguyên liệu;
if (Đủ nguyên liệu?) then (Có)
  :Trừ tồn, lưu Order PENDING, snapshot món\nvà Reservation ACTIVE kèm định lượng giữ kho;
  :Commit transaction tạo đơn;
  |NestJS API|
  :Trả 201 kèm orderId;
else (Không)
  |PostgreSQL|
  :Rollback transaction tạo đơn;
  |NestJS API|
  :Trả 409 thiếu kho;
  |Next.js UI|
  :Hiển thị lỗi thiếu nguyên liệu;
  stop
endif

|Next.js UI|
repeat :Chuẩn bị gửi thanh toán trên cùng orderId;
  note right
    Lần đầu hoặc sau FAILED: tạo khóa mới.
    Gửi lại khi chưa rõ kết quả: dùng lại khóa cũ.
    Cùng khóa phải giữ nguyên orderId và method VNPAY.
  end note
  :POST /api/payments\nBody: {orderId, method: "VNPAY"}\nHeader: Idempotency-Key;

  |NestJS API|
  :Xác thực JWT, kiểm tra cấu hình VNPay\nvà tra cứu theo Idempotency-Key;
  if (Đã có Payment với khóa này?) then (Có · Replay)
    |NestJS API|
    :Đối chiếu chủ đơn, orderId và phương thức;
    if (Đúng chủ đơn và cùng nội dung?) then (Có)
      :Trả HTTP status và PaymentResponse đã lưu;
    else (Không)
      :Trả 403 sai chủ đơn hoặc 409 xung đột khóa;
      |Next.js UI|
      :Hiển thị lỗi thanh toán;
      stop
    endif
  else (Chưa · Lần mới)
    |PostgreSQL|
    :Bắt đầu Transaction A (khởi tạo thanh toán);
    |NestJS API|
    :Kiểm tra chủ đơn và điều kiện mở lần thanh toán;
    if (Có thể mở lần thanh toán mới?) then (Có)
    else (Không)
      |PostgreSQL|
      :Rollback Transaction A;
      |NestJS API|
      :Trả 403 / 409 tương ứng;
      |Next.js UI|
      :Hiển thị lỗi thanh toán;
      stop
    endif

    |PostgreSQL|
    if (Đơn đang PAYMENT_FAILED?) then (Có)
      :Khóa và kiểm tra tồn theo định lượng đã lưu;
      if (Còn đủ nguyên liệu?) then (Có)
        :Trừ tồn lại, chuyển Reservation RELEASED -> ACTIVE\nvà Order PAYMENT_FAILED -> PENDING;
      else (Không)
        :Rollback Transaction A;
        |NestJS API|
        :Trả 409 thiếu kho;
        |Next.js UI|
        :Hiển thị lỗi thiếu nguyên liệu;
        stop
      endif
    endif
    |PostgreSQL|
    :Lưu Payment PROCESSING và Commit Transaction A;
    |NestJS API|
    :Tạo vnp_TxnRef, amount * 100\nvà ký checkoutUrl (HMAC-SHA512);
    |PostgreSQL|
    :Lưu providerTxnRef, checkoutUrl, expiresAt;
    |NestJS API|
    :Trả HTTP 202 PROCESSING + checkoutUrl;
  endif

  |Next.js UI|
  if (Nhận được checkoutUrl?) then (Có)
    :Redirect trình duyệt sang checkoutUrl;
    |VNPay Sandbox|
    :Khách hàng chọn phương thức\nvà xác thực giao dịch;

    fork
      |VNPay Sandbox|
      :Gọi IPN server-to-server\n(GET /api/payments/vnpay-ipn);
      |NestJS API|
      :Xác thực checksum HMAC-SHA512,\nmã giao dịch và số tiền;
      if (IPN hợp lệ và chưa chốt cuối?) then (Có)
        |PostgreSQL|
        :Bắt đầu Transaction B (ghi kết quả IPN);
        if (ResponseCode=00 và TransactionStatus=00?) then (PAID)
          :Payment & Order -> PAID, Reservation -> CONSUMED.\nCộng điểm EARN và tăng Promotion.usedCount nếu có;
        else (Không)
          if (Thất bại xác định?) then (FAILED)
            :Payment -> FAILED, Order -> PAYMENT_FAILED.\nHoàn tồn kho đúng một lần, Reservation -> RELEASED;
          else (Chưa xác định)
            :Payment -> UNKNOWN, giữ Order PENDING\nvà Reservation ACTIVE để đối soát;
          endif
        endif
        :Commit Transaction B;
        |NestJS API|
        :Trả {RspCode: "00", Message: "Confirm success"};
      else (Không)
        |NestJS API|
        :Trả RspCode 97 / 01 / 04 / 02;
      endif
    fork again
      |VNPay Sandbox|
      :Redirect trình duyệt về\nGET /api/payments/vnpay-return;
      |NestJS API|
      :Xác thực chữ ký Return, tìm paymentId\nvà 302 -> /checkout/vnpay-return;
      |Next.js UI|
      :Poll GET /api/payments/:paymentId\n(tối đa 20 lần, mỗi 1.5s);
    end fork
  endif

  |Next.js UI|
  if (Payment PAID?) then (Có)
    :Xóa giỏ hàng và hiển thị mã đơn + mã thanh toán;
    stop
  endif

  if (Payment FAILED?) then (FAILED)
    :Thông báo thất bại và hiện nút thử lại (/checkout);
  else (PROCESSING / UNKNOWN / chờ IPN)
    :Thông báo đang chờ VNPay IPN hoặc đối soát;
  endif

  |Khách hàng|
repeat while (Chủ động thử thanh toán lại?) is (Có) not (Không)

stop
@enduml
