@startuml
!pragma layout smetana
left to right direction

skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName "Noto Sans"

skinparam usecase {
  BackgroundColor #FFFDF8
  BorderColor #5D4037
  ArrowColor #5D4037
}

actor "Khách hàng" as Customer
actor "Nhân viên quầy\n/ Barista" as Barista
actor "Quản lý\n/ Manager" as Manager
actor "VNPay Sandbox" as VNPay

Manager --|> Barista

rectangle "Hệ thống BrewLite" {
  usecase "Xem và tìm kiếm menu\n(FR-01)" as UC_Menu
  usecase "Xem chi tiết, chọn\nsize và topping\n(FR-02)" as UC_Detail
  usecase "Quản lý giỏ hàng\n(FR-02)" as UC_Cart
  usecase "Kiểm tra tình trạng\nphục vụ món (FR-01, FR-02)" as UC_Availability

  usecase "Đăng ký / đăng nhập\n(FR-03)" as UC_Auth
  usecase "Quên và đặt lại\nmật khẩu (FR-03)" as UC_Forgot

  usecase "Đặt và thanh toán\nđơn hàng (UC-01)" as UC_Checkout
  usecase "Tạo đơn PENDING,\ntính giá và giữ tồn kho\n(FR-04, FR-07)" as UC_Order
  usecase "Thanh toán qua VNPay Sandbox\nvới Idempotency-Key\n(FR-05)" as UC_Payment
  usecase "Thanh toán lại đơn\nPAYMENT_FAILED\n(FR-05, FR-07)" as UC_RetryPayment
  usecase "Xử lý kết quả IPN\n(PAID/FAILED, kho, điểm, KM)\n(FR-05, FR-07, FR-08, FR-09)" as UC_Ipn
  usecase "Áp dụng mã giảm giá\nhợp lệ (FR-08)" as UC_Promo
  usecase "Xem, tích và đổi\nđiểm thưởng (FR-09)" as UC_Loyalty

  usecase "Xem kết quả thanh toán,\nlịch sử và theo dõi đơn\n(Return + polling, FR-06)" as UC_History

  usecase "Xem hàng đợi đơn\nđã thanh toán\n(FR-10)" as UC_Queue
  usecase "Cập nhật trạng thái\nđơn hàng\n(FR-10)" as UC_Status
}

' Chức năng của khách hàng
Customer -- UC_Menu
Customer -- UC_Cart
Customer -- UC_Auth
Customer -- UC_Forgot
Customer -- UC_Checkout
Customer -- UC_RetryPayment
Customer -- UC_History
Customer -- UC_Loyalty

' Chức năng của nhân viên quầy & quản lý
Barista -- UC_Auth
Barista -- UC_Queue
Barista -- UC_Status

' Hệ thống thanh toán bên ngoài
VNPay -- UC_Payment
VNPay -- UC_Ipn
VNPay -- UC_History

' Quan hệ include / extend
UC_Detail ..> UC_Menu : <<extend>>
UC_Availability ..> UC_Cart : <<include>>
UC_Forgot ..> UC_Auth : <<extend>>

UC_Checkout ..> UC_Auth : <<include>>
UC_Checkout ..> UC_Order : <<include>>
UC_Checkout ..> UC_Payment : <<include>>
UC_Checkout ..> UC_History : <<include>>
UC_Payment ..> UC_Ipn : <<include>>
UC_RetryPayment ..> UC_Payment : <<extend>>

UC_Promo ..> UC_Checkout : <<extend>>
UC_Loyalty ..> UC_Checkout : <<extend>>

@enduml
