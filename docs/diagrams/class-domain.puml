@startuml
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName "Noto Sans"
skinparam class {
  BackgroundColor #FFFDF8
  BorderColor #5D4037
  ArrowColor #5D4037
}
hide circle

class User {
  +UUID id
  +String email
  +String passwordHash
  +UserRole role
  +DateTime createdAt
}

class Product {
  +UUID id
  +String name
  +Decimal basePrice
  +String imageUrl
  +Boolean isAvailable
}

class ProductOption {
  +UUID id
  +OptionType type
  +String name
  +Decimal extraPrice
}

class OptionRecipe {
  +UUID productOptionId
  +UUID ingredientId
  +Decimal amount
}

class Ingredient {
  +UUID id
  +String name
  +IngredientUnit unit
  +Decimal stock
  +Int version
}

class Order {
  +UUID id
  +String orderNumber
  +OrderStatus status
  +Decimal subtotal
  +Decimal discount
  +Decimal total
  +DateTime createdAt
}

class OrderItem {
  +UUID id
  +String productNameSnapshot
  +Decimal unitPriceSnapshot
  +Int quantity
  +String optionsSnapshot
}

class OrderInventoryReservation {
  +UUID id
  +ReservationStatus status
  +Int version
  +DateTime createdAt
}

class OrderReservationLine {
  +UUID id
  +Decimal amount
}

class Payment {
  +UUID id
  +PaymentMethod method
  +PaymentStatus status
  +String idempotencyKey
  +Decimal amount
}

class Promotion {
  +UUID id
  +String code
  +DiscountType type
  +Decimal value
  +DateTime expiresAt
}

class LoyaltyTransaction {
  +UUID id
  +Int points
  +LoyaltyType type
  +DateTime createdAt
}

enum UserRole {
  CUSTOMER
  BARISTA
  MANAGER
}
enum OrderStatus {
  PENDING
  PAID
  PAYMENT_FAILED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}
enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}
enum PaymentStatus {
  PROCESSING
  PAID
  FAILED
  UNKNOWN
}
enum PaymentMethod {
  WALLET
  CARD
}
enum OptionType {
  SIZE
  TOPPING
}
enum IngredientUnit {
  G
  ML
  PIECE
}
enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}
enum LoyaltyType {
  EARN
  REDEEM
  REVERSE
}

User "1" -- "0..*" Order : places
Order "1" *-- "1..*" OrderItem
Order "1" -- "0..*" Payment : processed by
Product "1" -- "0..*" OrderItem : snapshot from
Product "1" *-- "0..*" ProductOption
ProductOption "1" *-- "0..*" OptionRecipe
OptionRecipe "0..*" -- "1" Ingredient : consumes
Order "1" -- "0..1" OrderInventoryReservation : reserves
OrderInventoryReservation "1" *-- "1..*" OrderReservationLine
OrderReservationLine "0..*" -- "1" Ingredient : holds stock
Order "0..*" -- "0..1" Promotion : applies
User "1" -- "0..*" LoyaltyTransaction
Order "0..1" -- "0..*" LoyaltyTransaction
User --> UserRole
Order --> OrderStatus
OrderInventoryReservation --> ReservationStatus
Payment --> PaymentStatus
Payment --> PaymentMethod
ProductOption --> OptionType
Ingredient --> IngredientUnit
Promotion --> DiscountType
LoyaltyTransaction --> LoyaltyType
@enduml
