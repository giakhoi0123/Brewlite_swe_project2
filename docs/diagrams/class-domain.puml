@startuml
!pragma layout smetana
top to bottom direction

title Class Diagram - Checkout và VNPay

skinparam shadowing false
skinparam defaultFontName "Noto Sans"
skinparam packageStyle rectangle
skinparam nodesep 25
skinparam ranksep 30
skinparam class {
  BackgroundColor #FFFDF8
  BorderColor #5D4037
  ArrowColor #5D4037
}
hide circle
hide empty members

package "NestJS API" {
  class OrdersController <<controller>> {
    +createOrder()
  }

  class PaymentsController <<controller>> {
    +createPayment()
    +handleVnpayIpn()
    +getPaymentStatus()
  }

  class OrdersService <<service>> {
    +createOrder()
    +transitionOrderStatusInTransaction()
    -lockIngredients()
  }

  class PaymentsService <<service>> {
    +processPayment()
    +handleVnpayIpn()
    +resolveVnpayReturn()
    +getPaymentStatus()
  }

  interface PaymentGatewayPort {
    +process()
    +verifyCallback()
  }

  class VnpayPaymentGatewayAdapter <<adapter>> {
    +process()
    +verifyCallback()
  }
}

package "Prisma / PostgreSQL" {
  class User <<entity>> {
    +id: UUID
    +loyaltyPoints: Int
  }

  class Order <<entity>> {
    +id: UUID
    +status: OrderStatus
    +total: Decimal
    +pointsRedeemed: Int
    +pointsEarned: Int
  }

  class Payment <<entity>> {
    +id: UUID
    +amount: Decimal
    +status: PaymentStatus
    +providerTxnRef: String?
    +processedAt: DateTime?
  }

  class OrderInventoryReservation <<entity>> {
    +id: UUID
    +status: ReservationStatus
  }

  class Promotion <<entity>> {
    +id: UUID
    +code: String
    +usedCount: Int
  }

  class LoyaltyLog <<entity>> {
    +id: UUID
    +points: Int
    +type: LoyaltyType
  }
}

OrdersController --> OrdersService
PaymentsController --> PaymentsService
PaymentsService --> OrdersService : cập nhật đơn/kho
PaymentsService --> PaymentGatewayPort
VnpayPaymentGatewayAdapter ..|> PaymentGatewayPort

OrdersService ..> Order
OrdersService ..> OrderInventoryReservation
PaymentsService ..> Payment

User "1" -- "0..*" Order
User "1" -- "0..*" LoyaltyLog
Order "1" *-- "0..*" Payment
Order "1" *-- "0..1" OrderInventoryReservation
Order "0..*" --> "0..1" Promotion
Order "1" -- "0..*" LoyaltyLog

@enduml
