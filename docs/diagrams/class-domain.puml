@startuml
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName "Noto Sans"
skinparam class {
  BackgroundColor #FFFDF8
  BorderColor #5D4037
  ArrowColor #5D4037
}
hide circle

class User {
  +UUID id
  +String email
  +String passwordHash
  +String fullName
  +UserRole role
  +Int sessionVersion
  +Int loyaltyPoints
  +DateTime createdAt
}

class PasswordResetToken {
  +UUID id
  +String tokenHash
  +DateTime expiresAt
  +Boolean used
  +DateTime createdAt
}

class Product {
  +UUID id
  +String name
  +Decimal basePrice
  +String imageUrl
  +Boolean isAvailable
}

class ProductOption {
  +UUID id
  +OptionType type
  +String name
  +Decimal extraPrice
}

class OptionRecipe {
  +UUID productOptionId
  +UUID ingredientId
  +Decimal amount
}

class Ingredient {
  +UUID id
  +String name
  +IngredientUnit unit
  +Decimal stock
  +Int version
}

class Order {
  +UUID id
  +String orderNumber
  +OrderStatus status
  +Int version
  +Decimal subtotal
  +Decimal discount
  +Decimal total
  +String voucherCode
  +Int pointsEarned
  +Int pointsRedeemed
  +String notes
  +DateTime createdAt
}

class OrderItem {
  +UUID id
  +String productNameSnapshot
  +Decimal unitPriceSnapshot
  +Int quantity
  +Decimal subtotal
  +Json optionsSnapshot
}

class OrderItemOption {
  +UUID id
  +String optionNameSnapshot
  +OptionType optionType
  +Decimal extraPriceSnapshot
  +DateTime createdAt
}

class OrderStatusHistory {
  +UUID id
  +OrderStatus fromStatus
  +OrderStatus toStatus
  +UUID actorId
  +String reason
  +DateTime createdAt
}

class OrderInventoryReservation {
  +UUID id
  +ReservationStatus status
  +Int version
  +DateTime createdAt
}

class OrderReservationLine {
  +UUID id
  +Decimal amount
}

class Payment {
  +UUID id
  +PaymentMethod method
  +PaymentStatus status
  +PaymentResultCode resultCode
  +String idempotencyKey
  +Decimal amount
}

class Promotion {
  +UUID id
  +String code
  +String description
  +DiscountType discountType
  +Decimal discountValue
  +Decimal minOrderAmount
  +Decimal maxDiscount
  +Int usageLimit
  +Int usedCount
  +Boolean isActive
  +DateTime startDate
  +DateTime endDate
}

class LoyaltyTransaction {
  +UUID id
  +Int points
  +Decimal amount
  +LoyaltyType type
  +String reason
  +DateTime createdAt
}

enum UserRole {
  CUSTOMER
  BARISTA
  MANAGER
}
enum OrderStatus {
  PENDING
  PROCESSING
  PAID
  PAYMENT_FAILED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}
enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}
enum PaymentStatus {
  PROCESSING
  PAID
  FAILED
  UNKNOWN
}
enum PaymentResultCode {
  PAYMENT_PAID
  PAYMENT_DECLINED
  PAYMENT_PROCESSING
  PAYMENT_STATUS_UNKNOWN
}
enum PaymentMethod {
  WALLET
  CARD
}
enum OptionType {
  SIZE
  TOPPING
}
enum IngredientUnit {
  G
  ML
  PIECE
}
enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}
enum LoyaltyType {
  EARN
  REDEEM
  REVERSE
}

User "1" -- "0..*" PasswordResetToken : requests
User "1" -- "0..*" Order : places
Order "1" *-- "1..*" OrderItem
OrderItem "1" *-- "0..*" OrderItemOption
ProductOption "1" -- "0..*" OrderItemOption : snapshot from
Order "1" *-- "0..*" OrderStatusHistory : tracks
Order "1" -- "0..*" Payment : processed by
Product "1" -- "0..*" OrderItem : snapshot from
Product "1" *-- "0..*" ProductOption
ProductOption "1" *-- "0..*" OptionRecipe
OptionRecipe "0..*" -- "1" Ingredient : consumes
Order "1" -- "0..1" OrderInventoryReservation : reserves
OrderInventoryReservation "1" *-- "1..*" OrderReservationLine
OrderReservationLine "0..*" -- "1" Ingredient : holds stock
Order "0..*" -- "0..1" Promotion : applies
User "1" -- "0..*" LoyaltyTransaction
Order "0..1" -- "0..*" LoyaltyTransaction

User --> UserRole
Order --> OrderStatus
OrderStatusHistory --> OrderStatus
OrderInventoryReservation --> ReservationStatus
Payment --> PaymentStatus
Payment --> PaymentResultCode
Payment --> PaymentMethod
ProductOption --> OptionType
OrderItemOption --> OptionType
Ingredient --> IngredientUnit
Promotion --> DiscountType
LoyaltyTransaction --> LoyaltyType
@enduml