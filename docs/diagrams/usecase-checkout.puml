@startuml
!pragma layout smetana
left to right direction

title UC-01 - Đặt hàng và thanh toán VNPay

skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName "Noto Sans"
skinparam nodesep 30
skinparam ranksep 35
skinparam usecase {
  BackgroundColor #FFFDF8
  BorderColor #5D4037
  ArrowColor #5D4037
}

actor "Khách hàng" as Customer
actor "VNPay Sandbox" as VNPay

rectangle "BrewLite - Phạm vi UC-01" {
  usecase "UC-01\nĐặt và thanh toán\nđơn hàng" as Checkout
  usecase "Xác thực, kiểm tra giỏ\nvà tính lại giá\n(FR-02, FR-03, FR-04)" as Validate
  usecase "Tạo đơn PENDING\n(tính giá, voucher, đổi điểm,\ngiữ tồn kho)\n(FR-04, FR-07, FR-08, FR-09)" as CreateOrder
  usecase "Thanh toán qua\nVNPay Sandbox\nvới Idempotency-Key\n(FR-05)" as Pay
  usecase "Thanh toán lại đơn\nPAYMENT_FAILED\n(tái kiểm tra và giữ kho)\n(FR-05, FR-07)" as RetryPayment
  usecase "Xử lý kết quả IPN\n(PAID/FAILED, kho,\nđiểm, khuyến mãi)\n(FR-05, FR-07, FR-08, FR-09)" as ProcessIpn
  usecase "Xem kết quả thanh toán,\nmã đơn và trạng thái đơn\n(Return + polling, FR-06)" as ViewResult
  usecase "Áp dụng mã giảm giá\nhợp lệ\n(FR-08)" as Promo
  usecase "Tích / đổi điểm thưởng\n(FR-09)" as Loyalty
}

Customer -- Checkout
Customer -- RetryPayment

Checkout ..> Validate : <<include>>
Checkout ..> CreateOrder : <<include>>
Checkout ..> Pay : <<include>>
Checkout ..> ViewResult : <<include>>
Promo ..> Checkout : <<extend>>
Loyalty ..> Checkout : <<extend>>
RetryPayment ..> Pay : <<extend>>
Pay ..> ProcessIpn : <<include>>

VNPay -- Pay
VNPay -- ProcessIpn
VNPay -- ViewResult

note bottom of Checkout
Tiền điều kiện: khách đã đăng nhập;
giỏ có ít nhất một món hợp lệ.
Thành công: Order và Payment = PAID; trả mã đơn.
Thất bại xác định: Payment = FAILED,
Order = PAYMENT_FAILED; hoàn kho đúng một lần.
Timeout/UNKNOWN: Order giữ PENDING để đối soát.
end note
@enduml
