@startuml
!pragma layout smetana
left to right direction

title UC-01 - Đặt hàng và thanh toán VNPay

skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName "Noto Sans"
skinparam nodesep 30
skinparam ranksep 35
skinparam usecase {
  BackgroundColor #FFFDF8
  BorderColor #5D4037
  ArrowColor #5D4037
}

actor "Khách hàng" as Customer
actor "VNPay Sandbox" as VNPay

rectangle "BrewLite - Checkout" {
  usecase "Đặt và thanh toán\nđơn hàng" as Checkout
  usecase "Tạo đơn PENDING\n(tính giá, voucher, đổi điểm,\ngiữ tồn kho)" as CreateOrder
  usecase "Thanh toán qua\nVNPay Sandbox" as Pay
  usecase "Thanh toán lại đơn\nPAYMENT_FAILED\n(tái kiểm tra và giữ kho)" as RetryPayment
  usecase "Xử lý kết quả IPN\n(PAID/FAILED, kho,\nđiểm, khuyến mãi)" as ProcessIpn
  usecase "Xem kết quả thanh toán\n(Return + polling)" as ViewResult
}

Customer -- Checkout
Customer -- RetryPayment

Checkout ..> CreateOrder : <<include>>
Checkout ..> Pay : <<include>>
Checkout ..> ViewResult : <<include>>
RetryPayment ..> Pay : <<extend>>
Pay ..> ProcessIpn : <<include>>

VNPay -- Pay
VNPay -- ProcessIpn
VNPay -- ViewResult

@enduml
