    {
      "name": "04. Login - Thanh cong (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Returns accessToken & user info', () => {",
              "  pm.expect(json.accessToken).to.be.a('string').and.not.empty;",
              "  pm.expect(json.user.email).to.eql(pm.collectionVariables.get('testEmail'));",
              "});",
              "pm.collectionVariables.set('accessToken', json.accessToken);",
              "pm.collectionVariables.set('oldToken', json.accessToken);"
            ]
