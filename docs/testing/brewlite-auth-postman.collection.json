{
  "info": {
    "name": "BrewLite - Auth BE Test Suite (Khoi)",
    "_postman_id": "6f80c197-777d-4768-a191-b32441b57406",
    "description": "Bo test Postman day du cho module Auth (Register, Login, Me, Change Password + SessionVersion, Forgot/Reset Password, Logout). Chay theo thu tu tu 01 den 14 hoac dung Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3005/api"
    },
    {
      "key": "testEmail",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "oldToken",
      "value": ""
    },
    {
      "key": "resetToken",
      "value": "invalid-token-demo"
    }
  ],
  "item": [
    {
      "name": "01. Register - Thanh cong (201)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const uniqueEmail = `khoi.test.${Date.now()}@brewlite.test`;",
              "pm.collectionVariables.set('testEmail', uniqueEmail);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201 Created', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test('Has accessToken and CUSTOMER role', () => {",
              "  pm.expect(json.accessToken).to.be.a('string').and.not.empty;",
              "  pm.expect(json.user.role).to.eql('CUSTOMER');",
              "  pm.expect(json.user).to.not.have.property('passwordHash');",
              "});",
              "pm.collectionVariables.set('accessToken', json.accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Pham Gia Khoi Test\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"Password123!\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "register"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02. Register - Trung Email (409)",
      "event": [
