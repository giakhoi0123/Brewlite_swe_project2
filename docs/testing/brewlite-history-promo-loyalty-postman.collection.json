            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Returns active promotions without expired codes', () => {",
              "  pm.expect(json).to.be.an('array');",
              "  const codes = json.map((p) => p.code);",
              "  pm.expect(codes).to.include('HELLOBREW');",
              "  pm.expect(codes).to.include('BREW20');",
              "  pm.expect(codes).to.not.include('EXPIRED10');",
