    {
      "name": "16. Order History - Xem lich su don cua toi /orders/me (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Contains newly created order without leaking internal fields', () => {",
              "  pm.expect(json).to.be.an('array').that.is.not.empty;",
              "  const created = json.find((o) => o.id === pm.collectionVariables.get('otherOrderId'));",
              "  pm.expect(created).to.be.an('object');",
              "  pm.expect(created.voucherCode).to.eql('HELLOBREW');",
              "  pm.expect(created).to.not.have.property('reservation');",
              "  pm.expect(created).to.not.have.property('version');",
              "});"
            ]
          }
        }
      ],
