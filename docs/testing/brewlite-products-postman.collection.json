  "item": [
    {
      "name": "01. Get Products - Danh sach toan bo menu (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Returns non-empty product list with orderability fields', () => {",
              "  pm.expect(json).to.be.an('array').that.is.not.empty;",
              "  pm.expect(json.length).to.be.at.least(8);",
              "  const first = json[0];",
              "  pm.expect(first).to.have.all.keys('id', 'name', 'basePrice', 'imageUrl', 'isAvailable', 'canOrder', 'createdAt');",
              "  pm.expect(first.basePrice).to.be.a('number');",
              "});",
              "const availableItem = json.find((p) => p.id === 'a0000000-0000-0000-0000-000000000001') || json[0];",
              "pm.collectionVariables.set('sampleProductId', availableItem.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02. Search Products - Tim khong phan biet hoa thuong (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Filters products matching search term case-insensitively', () => {",
              "  pm.expect(json).to.be.an('array').that.is.not.empty;",
              "  json.forEach((item) => {",
              "    pm.expect(item.name.toLowerCase()).to.include('cà phê');",
              "  });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products?search=CÀ PHÊ",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products"
          ],
          "query": [
            {
              "key": "search",
              "value": "CÀ PHÊ"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "03. Search Products - Khong khop tra mang rong (200)",
      "event": [
