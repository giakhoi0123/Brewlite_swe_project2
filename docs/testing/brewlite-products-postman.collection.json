    {
      "name": "07. Check Availability - Gio hang hop le du nguyen lieu (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201 Created', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test('Cart line is orderable with availableQuantity >= 2', () => {",
              "  pm.expect(json.canOrder).to.eql(true);",
              "  pm.expect(json.items).to.be.an('array').with.lengthOf(1);",
              "  pm.expect(json.items[0].canOrder).to.eql(true);",
              "  pm.expect(json.items[0].availableQuantity).to.be.at.least(2);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"{{sampleProductId}}\",\n      \"sizeId\": \"{{sampleSizeId}}\",\n      \"toppingIds\": [\n        \"{{sampleToppingId}}\"\n      ],\n      \"quantity\": 2\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/products/availability",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products",
            "availability"
          ]
        }
      },
      "response": []
    },
