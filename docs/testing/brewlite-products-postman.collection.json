          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201 Created', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test('Out-of-stock item returns canOrder false and availableQuantity 0', () => {",
              "  pm.expect(json.canOrder).to.eql(false);",
              "  pm.expect(json.items[0].canOrder).to.eql(false);",
              "  pm.expect(json.items[0].availableQuantity).to.eql(0);",
              "});"
            ]
          }
        }
      ],
