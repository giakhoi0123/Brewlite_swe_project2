    {
      "name": "04. Get Product Detail - Mon co options Size & Topping (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Returns product detail with SIZE and TOPPING options', () => {",
              "  pm.expect(json.id).to.eql(pm.collectionVariables.get('sampleProductId'));",
              "  pm.expect(json.options).to.be.an('array').that.is.not.empty;",
              "  const size = json.options.find((o) => o.type === 'SIZE');",
              "  const topping = json.options.find((o) => o.type === 'TOPPING');",
              "  pm.expect(size).to.be.an('object');",
              "  pm.collectionVariables.set('sampleSizeId', size.id);",
              "  if (topping) pm.collectionVariables.set('sampleToppingId', topping.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/products/{{sampleProductId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "products",
            "{{sampleProductId}}"
          ]
        }
      },
      "response": []
    },
