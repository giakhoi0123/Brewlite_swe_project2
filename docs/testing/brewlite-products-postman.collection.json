              "pm.test('Status code is 200 OK', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Returns empty array when no product matches', () => {",
              "  pm.expect(json).to.be.an('array').that.is.empty;",
              "});"
            ]
          }
        }
