    {
      "name": "08. Create Payment VNPay - Khoi tao PROCESSING + checkoutUrl (202)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('idempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 202 Accepted', () => pm.response.to.have.status(202));",
              "const json = pm.response.json();",
              "pm.test('Returns PROCESSING status and signed VNPay checkoutUrl', () => {",
              "  pm.expect(json.paymentStatus).to.eql('PROCESSING');",
              "  pm.expect(json.orderStatus).to.eql('PENDING');",
              "  pm.expect(json.method).to.eql('VNPAY');",
              "  pm.expect(json.checkoutUrl).to.include('vnp_SecureHash=');",
              "});",
              "pm.collectionVariables.set('paymentId', json.paymentId);",
              "const query = (json.checkoutUrl.split('?')[1] || '');",
              "query.split('&').forEach((pair) => {",
              "  const [k, v] = pair.split('=');",
              "  if (k === 'vnp_TmnCode') pm.collectionVariables.set('vnpayTmnCode', decodeURIComponent(v || ''));",
              "  if (k === 'vnp_TxnRef') pm.collectionVariables.set('vnpayTxnRef', decodeURIComponent(v || ''));",
              "  if (k === 'vnp_Amount') pm.collectionVariables.set('vnpayAmount', decodeURIComponent(v || ''));",
              "});"
            ]
          }
        }
      ],
