      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('retryIdempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.collectionVariables.get('vnpayHashSecret')) {",
              "  pm.test('Status code is 202 Accepted on retry after PAYMENT_FAILED', () => pm.response.to.have.status(202));",
              "  const json = pm.response.json();",
              "  pm.expect(json.paymentStatus).to.eql('PROCESSING');",
              "  pm.collectionVariables.set('paymentId', json.paymentId);",
              "  const query = (json.checkoutUrl.split('?')[1] || '');",
              "  query.split('&').forEach((pair) => {",
              "    const [k, v] = pair.split('=');",
              "    if (k === 'vnp_TxnRef') pm.collectionVariables.set('vnpayTxnRef', decodeURIComponent(v || ''));",
              "  });",
              "} else {",
              "  pm.test('Without signed failed IPN, previous attempt is still PROCESSING -> 409', () => pm.response.to.have.status(409));",
              "}"
            ]
          }
        }
      ],
