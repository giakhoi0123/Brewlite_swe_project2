    {
      "name": "14. VNPay IPN - Khong tim thay giao dich (RspCode 01)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const secret = pm.collectionVariables.get('vnpayHashSecret') || '';",
              "const params = {",
              "  vnp_Amount: pm.collectionVariables.get('vnpayAmount') || '5000000',",
              "  vnp_BankCode: 'NCB',",
              "  vnp_PayDate: '20261115003000',",
              "  vnp_ResponseCode: '00',",
              "  vnp_TmnCode: pm.collectionVariables.get('vnpayTmnCode') || 'UNSET',",
              "  vnp_TransactionNo: '14000001',",
              "  vnp_TransactionStatus: '00',",
              "  vnp_TxnRef: pm.collectionVariables.get('vnpMissingTxnRef')",
              "};",
              "const query = Object.keys(params).sort().map((k) => `${k}=${encodeURIComponent(params[k]).replace(/%20/g, '+')}`).join('&');",
              "const hash = secret ? CryptoJS.HmacSHA512(query, secret).toString(CryptoJS.enc.Hex) : 'missing-secret';",
              "pm.collectionVariables.set('vnpSecureHash', hash);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "if (pm.collectionVariables.get('vnpayHashSecret')) {",
              "  pm.test('Unknown TxnRef returns RspCode 01', () => pm.expect(json.RspCode).to.eql('01'));",
              "} else {",
              "  pm.test('No vnpayHashSecret configured -> RspCode 97', () => pm.expect(json.RspCode).to.eql('97'));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/payments/vnpay-ipn?vnp_Amount={{vnpayAmount}}&vnp_BankCode=NCB&vnp_PayDate=20261115003000&vnp_ResponseCode=00&vnp_TmnCode={{vnpayTmnCode}}&vnp_TransactionNo=14000001&vnp_TransactionStatus=00&vnp_TxnRef={{vnpMissingTxnRef}}&vnp_SecureHash={{vnpSecureHash}}",
          "host": [
