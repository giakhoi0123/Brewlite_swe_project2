    {
      "name": "10. Barista Queue - Barista xem hang doi loai tru PENDING (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200 OK', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test('Queue has data/meta and excludes PENDING orders', () => {",
              "  pm.expect(json.data).to.be.an('array');",
              "  pm.expect(json.meta).to.have.all.keys('total', 'page', 'limit', 'totalPages');",
              "  const pendingId = pm.collectionVariables.get('pendingOrderId');",
              "  const foundPending = json.data.find((o) => o.id === pendingId);",
              "  pm.expect(foundPending).to.be.undefined;",
              "  json.data.forEach((o) => {",
              "    pm.expect(['PAID', 'PREPARING', 'READY']).to.include(o.status);",
              "  });",
              "});",
              "const firstPaid = json.data.find((o) => o.status === 'PAID');",
              "if (firstPaid) pm.collectionVariables.set('paidOrderId', firstPaid.id);"
            ]
          }
        }
      ],
