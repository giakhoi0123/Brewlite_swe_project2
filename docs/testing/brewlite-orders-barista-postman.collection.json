    },
    {
      "name": "12b. Helper - Ky VNPay IPN thanh cong neu co vnpayHashSecret (200)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const secret = pm.collectionVariables.get('vnpayHashSecret') || '';",
              "const orderInfo = `Thanh toan don hang ${pm.collectionVariables.get('pendingOrderId')}`;",
              "const payDate = '20261115003000';",
              "const txnNo = `${Date.now()}`.slice(-8);",
              "pm.collectionVariables.set('vnpOrderInfo', orderInfo);",
              "pm.collectionVariables.set('vnpPayDate', payDate);",
              "pm.collectionVariables.set('vnpTransactionNo', txnNo);",
              "const params = {",
              "  vnp_Amount: pm.collectionVariables.get('vnpayAmount') || '4900000',",
              "  vnp_BankCode: 'NCB',",
              "  vnp_OrderInfo: orderInfo,",
              "  vnp_PayDate: payDate,",
              "  vnp_ResponseCode: '00',",
              "  vnp_TmnCode: pm.collectionVariables.get('vnpayTmnCode') || 'UNSET',",
              "  vnp_TransactionNo: txnNo,",
              "  vnp_TransactionStatus: '00',",
              "  vnp_TxnRef: pm.collectionVariables.get('vnpayTxnRef') || '0000'",
              "};",
              "const sortedKeys = Object.keys(params).sort();",
              "const query = sortedKeys.map((k) => `${k}=${encodeURIComponent(params[k]).replace(/%20/g, '+')}`).join('&');",
              "const hash = secret ? CryptoJS.HmacSHA512(query, secret).toString(CryptoJS.enc.Hex) : 'missing-secret';",
              "pm.collectionVariables.set('vnpSecureHash', hash);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('IPN endpoint returns HTTP 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "if (pm.collectionVariables.get('vnpayHashSecret')) {",
              "  pm.test('Order marked PAID via signed IPN (RspCode 00)', () => pm.expect(json.RspCode).to.eql('00'));",
              "  pm.collectionVariables.set('paidOrderId', pm.collectionVariables.get('pendingOrderId'));",
              "} else {",
              "  pm.test('Without vnpayHashSecret, IPN safely rejects checksum (RspCode 97)', () => pm.expect(json.RspCode).to.eql('97'));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/payments/vnpay-ipn?vnp_Amount={{vnpayAmount}}&vnp_BankCode=NCB&vnp_OrderInfo={{vnpOrderInfo}}&vnp_PayDate={{vnpPayDate}}&vnp_ResponseCode=00&vnp_TmnCode={{vnpayTmnCode}}&vnp_TransactionNo={{vnpTransactionNo}}&vnp_TransactionStatus=00&vnp_TxnRef={{vnpayTxnRef}}&vnp_SecureHash={{vnpSecureHash}}",
          "host": [
