    {
      "name": "07. Create Order - Thanh cong tao don PENDING giu kho & tinh lai gia (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201 Created', () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.test('Server calculates price (29000 + 5000 + 15000 shipping = 49000) and sets PENDING', () => {",
              "  pm.expect(json.id).to.be.a('string').and.not.empty;",
              "  pm.expect(json.orderNumber).to.be.a('string').and.not.empty;",
              "  pm.expect(json.status).to.eql('PENDING');",
              "  pm.expect(json.subtotal).to.eql(34000);",
              "  pm.expect(json.shippingFee).to.eql(15000);",
              "  pm.expect(json.total).to.eql(49000);",
              "});",
              "pm.collectionVariables.set('pendingOrderId', json.id);"
            ]
          }
        }
      ],
