    {
      "name": "12a. Helper - Khoi tao VNPay cho pendingOrderId (202)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('helperIdempotencyKey', pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 202 Accepted', () => pm.response.to.have.status(202));",
              "const json = pm.response.json();",
              "if (json.checkoutUrl) {",
              "  const query = json.checkoutUrl.split('?')[1] || '';",
              "  query.split('&').forEach((pair) => {",
              "    const [k, v] = pair.split('=');",
              "    if (k === 'vnp_TmnCode') pm.collectionVariables.set('vnpayTmnCode', decodeURIComponent(v || ''));",
              "    if (k === 'vnp_TxnRef') pm.collectionVariables.set('vnpayTxnRef', decodeURIComponent(v || ''));",
              "    if (k === 'vnp_Amount') pm.collectionVariables.set('vnpayAmount', decodeURIComponent(v || ''));",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
