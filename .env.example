# ==============================================================================
# BrewLite Environment Variables Configuration Template
# ==============================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=brewlite_user
POSTGRES_PASSWORD=brewlite_password
POSTGRES_DB=brewlite_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://brewlite_user:brewlite_password@localhost:5432/brewlite_db?schema=public"

# NestJS API Configuration
PORT=3005
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Next.js Web Configuration
NEXT_PUBLIC_API_URL=http://localhost:3005/api
