# ==============================================================================
# BrewLite Full Stack Environment Configuration (Docker Compose & Local Dev)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=brewlite_user
POSTGRES_PASSWORD=brewlite_password
POSTGRES_DB=brewlite_db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. Database Connection URL
# - Inside Docker Network: Hostname is 'postgres', port is internal 5432
# - Outside Docker (Local host): Hostname is 'localhost', port is POSTGRES_PORT (5432)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://brewlite_user:brewlite_password@postgres:5432/brewlite_db?schema=public"

# ------------------------------------------------------------------------------
# 3. Backend API Service Configuration (NestJS)
# ------------------------------------------------------------------------------
PORT=3005
API_PORT=3005
NODE_ENV=production

# JWT Authentication Secrets
JWT_SECRET=brewlite-super-secret-jwt-key-for-development
JWT_EXPIRES_IN=1d

# Allowed Frontend Origins for CORS (Align with Next.js web host/port)
CORS_ORIGIN=http://localhost:3006

# VNPay Sandbox (register credentials at https://sandbox.vnpayment.vn/devreg/)
# Keep VNPAY_HASH_SECRET out of source control and browser-facing variables.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3005/api/payments/vnpay-return
VNPAY_IPN_URL=http://localhost:3005/api/payments/vnpay-ipn
VNPAY_FRONTEND_RETURN_URL=http://localhost:3006/checkout/vnpay-return

# ------------------------------------------------------------------------------
# 4. Frontend Web Service Configuration (Next.js)
# ------------------------------------------------------------------------------
WEB_PORT=3006

# Public Backend API Endpoint for Browser Client
# IMPORTANT: Must use localhost / public domain because browser runs OUTSIDE Docker network.
NEXT_PUBLIC_API_URL=http://localhost:3005/api
