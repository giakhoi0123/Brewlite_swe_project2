# ==============================================================================
# BrewLite Local Docker Database Configuration
# ==============================================================================

# PostgreSQL Container Credentials (used by docker-compose.yml)
POSTGRES_USER=brewlite_user
POSTGRES_PASSWORD=brewlite_password
POSTGRES_DB=brewlite_db
POSTGRES_PORT=5432

