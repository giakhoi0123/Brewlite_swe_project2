# ==============================================================================
# BrewLite API (NestJS + Prisma) Environment Configuration
# ==============================================================================

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://brewlite_user:brewlite_password@localhost:5432/brewlite_db?schema=public"

# Server Port & Mode
PORT=3005
NODE_ENV=development

# Allowed Frontend Origins for CORS (Align with Next.js web port)
CORS_ORIGIN=http://localhost:3006
