# ==============================================================================
# BrewLite API (NestJS + Prisma) Environment Configuration
# ==============================================================================

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://brewlite_user:brewlite_password@localhost:5432/brewlite_db?schema=public"

# Server Port & Mode
PORT=3005
NODE_ENV=development

# JWT Authentication
JWT_SECRET=brewlite-super-secret-jwt-key-for-development
JWT_EXPIRES_IN=1d

# Allowed Frontend Origins for CORS (Align with Next.js web port)
CORS_ORIGIN=http://localhost:3006

# VNPay Sandbox (server-only)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3005/api/payments/vnpay-return
VNPAY_IPN_URL=http://localhost:3005/api/payments/vnpay-ipn
VNPAY_FRONTEND_RETURN_URL=http://localhost:3006/checkout/vnpay-return
