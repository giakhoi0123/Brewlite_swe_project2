datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum OptionType {
  SIZE
  TOPPING
}

enum IngredientUnit {
  G
  ML
  PIECE
}

enum UserRole {
  CUSTOMER
  BARISTA
  MANAGER
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
}

enum OrderStatus {
  PENDING
  PROCESSING
  PAID
  PAYMENT_FAILED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  WALLET
  CARD
}

enum PaymentStatus {
  PROCESSING
  PAID
  FAILED
  UNKNOWN
}

enum PaymentResultCode {
  PAYMENT_PAID
  PAYMENT_DECLINED
  PAYMENT_PROCESSING
  PAYMENT_STATUS_UNKNOWN
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  email          String   @unique @db.VarChar(255)
  passwordHash   String   @map("password_hash") @db.VarChar(255)
  fullName       String   @map("full_name") @db.VarChar(255)
  role           UserRole @default(CUSTOMER)
  sessionVersion Int      @default(1) @map("session_version")
  loyaltyPoints  Int      @default(0) @map("loyalty_points")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  passwordResetTokens PasswordResetToken[]
  loyaltyLogs         LoyaltyLog[]
  orders              Order[]

  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @map("token_hash") @db.VarChar(255)
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model Product {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(255)
  basePrice   Decimal  @map("base_price") @db.Decimal(10, 2)
  imageUrl    String   @map("image_url") @db.Text
  isAvailable Boolean  @default(true) @map("is_available")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  options    ProductOption[]
  orderItems OrderItem[]

  @@map("products")
}

model ProductOption {
  id         String     @id @default(uuid()) @db.Uuid
  productId  String     @map("product_id") @db.Uuid
  type       OptionType
  name       String     @db.VarChar(100)
  extraPrice Decimal    @default(0) @map("extra_price") @db.Decimal(10, 2)
  createdAt  DateTime   @default(now()) @map("created_at")

  product          Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  recipes          OptionRecipe[]
  orderItemOptions OrderItemOption[]

  @@index([productId])
  @@map("product_options")
}

model Ingredient {
  id        String         @id @default(uuid()) @db.Uuid
  name      String         @unique @db.VarChar(100)
  unit      IngredientUnit
  stock     Decimal        @default(0) @db.Decimal(12, 3)
  version   Int            @default(1)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  recipes          OptionRecipe[]
  reservationLines OrderReservationLine[]

  @@map("ingredients")
}

model OptionRecipe {
  productOptionId String  @map("product_option_id") @db.Uuid
  ingredientId    String  @map("ingredient_id") @db.Uuid
  amount          Decimal @db.Decimal(12, 3)

  productOption ProductOption @relation(fields: [productOptionId], references: [id], onDelete: Cascade)
  ingredient    Ingredient    @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@id([productOptionId, ingredientId])
  @@index([ingredientId])
  @@map("option_recipes")
}

model Promotion {
  id             String       @id @default(uuid()) @db.Uuid
  code           String       @unique @db.VarChar(50)
  description    String?      @db.Text
  discountType   DiscountType @map("discount_type")
  discountValue  Decimal      @map("discount_value") @db.Decimal(10, 2)
  minOrderAmount Decimal      @default(0) @map("min_order_amount") @db.Decimal(10, 2)
  maxDiscount    Decimal?     @map("max_discount") @db.Decimal(10, 2)
  usageLimit     Int?         @map("usage_limit")
  usedCount      Int          @default(0) @map("used_count")
  isActive       Boolean      @default(true) @map("is_active")
  startDate      DateTime     @map("start_date")
  endDate        DateTime     @map("end_date")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  orders Order[]

  @@map("promotions")
}

model LoyaltyLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  points    Int
  reason    String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("loyalty_logs")
}

model Order {
  id             String      @id @default(uuid()) @db.Uuid
  orderNumber    String      @unique @map("order_number") @db.VarChar(50)
  userId         String      @map("user_id") @db.Uuid
  status         OrderStatus @default(PENDING)
  version        Int         @default(1)
  subtotal       Decimal     @db.Decimal(10, 2)
  discount       Decimal     @default(0) @db.Decimal(10, 2)
  total          Decimal     @db.Decimal(10, 2)
  voucherCode    String?     @map("voucher_code") @db.VarChar(50)
  promotionId    String?     @map("promotion_id") @db.Uuid
  pointsEarned   Int         @default(0) @map("points_earned")
  pointsRedeemed Int         @default(0) @map("points_redeemed")
  notes          String?     @db.Text
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  user          User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  promotion     Promotion?                 @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  items         OrderItem[]
  reservation   OrderInventoryReservation?
  statusHistory OrderStatusHistory[]
  payments      Payment[]

  @@index([userId])
  @@index([promotionId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id                  String   @id @default(uuid()) @db.Uuid
  orderId             String   @map("order_id") @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  productNameSnapshot String   @map("product_name_snapshot") @db.VarChar(255)
  unitPriceSnapshot   Decimal  @map("unit_price_snapshot") @db.Decimal(10, 2)
  quantity            Int
  subtotal            Decimal  @db.Decimal(10, 2)
  optionsSnapshot     Json?    @map("options_snapshot")
  notes               String?  @db.Text
  createdAt           DateTime @default(now()) @map("created_at")

  order            Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  orderItemOptions OrderItemOption[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderItemOption {
  id                 String     @id @default(uuid()) @db.Uuid
  orderItemId        String     @map("order_item_id") @db.Uuid
  productOptionId    String     @map("product_option_id") @db.Uuid
  optionNameSnapshot String     @map("option_name_snapshot") @db.VarChar(100)
  optionType         OptionType @map("option_type")
  extraPriceSnapshot Decimal    @map("extra_price_snapshot") @db.Decimal(10, 2)
  createdAt          DateTime   @default(now()) @map("created_at")

  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  productOption ProductOption @relation(fields: [productOptionId], references: [id], onDelete: Restrict)

  @@unique([orderItemId, productOptionId])
  @@index([orderItemId])
  @@index([productOptionId])
  @@map("order_item_options")
}

model OrderInventoryReservation {
  id         String            @id @default(uuid()) @db.Uuid
  orderId    String            @unique @map("order_id") @db.Uuid
  status     ReservationStatus @default(ACTIVE)
  version    Int               @default(1)
  createdAt  DateTime          @default(now()) @map("created_at")
  consumedAt DateTime?         @map("consumed_at")
  releasedAt DateTime?         @map("released_at")
  updatedAt  DateTime          @updatedAt @map("updated_at")

  order Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lines OrderReservationLine[]

  @@index([status])
  @@map("order_inventory_reservations")
}

model OrderReservationLine {
  id            String  @id @default(uuid()) @db.Uuid
  reservationId String  @map("reservation_id") @db.Uuid
  ingredientId  String  @map("ingredient_id") @db.Uuid
  amount        Decimal @db.Decimal(12, 3)

  reservation OrderInventoryReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  ingredient  Ingredient                @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  @@unique([reservationId, ingredientId])
  @@index([ingredientId])
  @@map("order_reservation_lines")
}

model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actorId    String?      @map("actor_id") @db.Uuid
  reason     String?      @db.VarChar(255)
  createdAt  DateTime     @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Payment {
  id                 String            @id @default(uuid()) @db.Uuid
  orderId            String            @map("order_id") @db.Uuid
  idempotencyKey     String            @unique @map("idempotency_key") @db.Uuid
  requestFingerprint String            @map("request_fingerprint") @db.Char(64)
  method             PaymentMethod
  amount             Decimal           @db.Decimal(10, 2)
  status             PaymentStatus     @default(PROCESSING)
  resultCode         PaymentResultCode @default(PAYMENT_PROCESSING) @map("result_code")
  retryable          Boolean           @default(false)
  httpStatus         Int               @default(202) @map("http_status")
  processedAt        DateTime?         @map("processed_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("payments")
}